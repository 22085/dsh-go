# dsh-go: guard plugin-manager changes against an earlier package tree outliving
# its Host and the profile lock (active recorded run). Adapted for dsh 0.2.2-rc.1:
# change() now takes an identity 4th argument, so the cancellation callback is
# passed as a 5th argument instead of reusing the 4th.
--- a/node_modules/@deepseek-ai/dsh-plugin-manager/lib/index.js
+++ b/node_modules/@deepseek-ai/dsh-plugin-manager/lib/index.js
@@ -1,6 +1,6 @@
 				});
 			}, {
 				stage: "install",
 				target: spec,
 				enabled: options?.enabled !== false
-			}, "install");
+			}, "install", void 0, stopped);
@@ -1,1 +1,1 @@
-		async change(operation, request, reason, identity) {
+		async change(operation, request, reason, identity, isCancelled) {
@@ -1,4 +1,10 @@
 					};
 					try {
+						if (isCancelled?.()) throw new InstallCancelledError();
+						// An earlier package tree may outlive its Host and the profile lock.
+						const active = await activeRecordedRun(this.profile.dir);
+						if (isCancelled?.()) throw new InstallCancelledError();
+						this.abort.signal.throwIfAborted();
+						if (active !== void 0) throw new Error(active);
 						const outcome = await operation(result);
 						if (outcome !== void 0) result.application = outcome;
